# ==========================================================
#  pegazo (frontend) — Variables de entorno
#  Copia este archivo a .env.local y ajusta los valores.
#  Nota: en Next.js las variables NEXT_PUBLIC_* se exponen
#  al navegador (no pongas secretos aquí).
# ==========================================================

# URL base de la API (backend NestJS).
# En desarrollo el backend arranca por defecto en el puerto 3002.
NEXT_PUBLIC_API_URL=http://localhost:3002

# URL pública usada para el enlace de verificación de ventas
# (en la factura/comprobante). Si se deja vacía, usa el dominio actual.
NEXT_PUBLIC_VERIFY_URL=https://pegazo.co
